# ─── REQUIRED — the app is non-functional without these ──────────────────────
# Projects, Library, and every server function are gated on a Supabase session
# and the service-role (admin) client. Missing any of the three below and the
# symptoms are: empty Projects list + "New Project" silently fails (no session
# → every server fn is Unauthorized; and the admin client throws on create).
#
# Auth model (see src/routes/_authenticated.tsx + src/lib/gate.functions.ts):
# the app silently signs into ONE shared Supabase user, so the whole team
# shares the same projects. These are app-specific — no Vercel/Supabase
# integration provides them; set them by hand (Vercel → Settings → Env Vars,
# for Production AND Preview).
SHARED_ACCOUNT_EMAIL=
SITE_PASSWORD=
# Service-role key for the personal Supabase project hardcoded in
# src/integrations/supabase/my-config.ts. NOTE the MY_ prefix — the Vercel
# Supabase integration injects SUPABASE_SERVICE_ROLE_KEY (no prefix), which
# this app does NOT read, so setting it via the integration alone won't work.
MY_SUPABASE_SERVICE_ROLE_KEY=

# ─── Application database (Vercel Neon) ───────────────────────────────────────
# The Vercel Marketplace integration injects this automatically. Locally, pull
# the Development environment from Vercel or add a Neon development connection.
# When absent, local development temporarily falls back to Supabase data.
NEON_DATABASE_URL=

# ─── Site password gate ───────────────────────────────────────────────────────
# Blocks ALL site content behind a password form until entered (checked
# server-side, never shipped to the client). Set this on any shared/deployed
# environment before sharing the URL. Leave UNSET locally to skip the gate
# during development. Distinct from SITE_PASSWORD above (that's the internal
# Supabase account password; this is the public-facing gate).
SITE_GATE_PASSWORD=

# ─── AI and media generation ──────────────────────────────────────────────────
# Pika is the server-side provider for the studio agent and generated media.
# Never prefix this with VITE_ — doing so would expose the secret to browsers.
PIKA_API_KEY=
PIKA_API_BASE_URL=https://api.dev.pika.art

# Retained only for legacy project naming flows that still use the exported
# Lovable integration.
LOVABLE_API_KEY=

# Optional integrations; only needed for their corresponding features.
FIRECRAWL_API_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=v1

# Optional bearer token for public local hook endpoints.
LOCAL_HOOK_TOKEN=
