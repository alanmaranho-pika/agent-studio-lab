# AI chat and project naming. ANTHROPIC_API_KEY is preferred for chat;
# LOVABLE_API_KEY remains supported by the exported Lovable integration.
ANTHROPIC_API_KEY=
LOVABLE_API_KEY=

# Optional integrations; only needed for their corresponding features.
FAL_KEY=
PIKA_API_KEY=
FIRECRAWL_API_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=v1

# Optional bearer token for public local hook endpoints.
LOCAL_HOOK_TOKEN=
